// Showcase game (#611, docs/showcase-plan.md row 9) — the just-shipped
// post-fx set (labelle-gfx#305) on bgfx, the backend that ships all four
// full-screen shader passes.
//
// The `.post_fx` block below is the WHOLE feature surface: the assembler
// emits it as a `g.setPostFx(...)` seed (src/codegen/blocks/post_fx.zig),
// the engine forwards it to gfx's `PostFxDriver` (post_fx_mixin.zig, gated
// on gfx >= 1.28), and bgfx renders each pass from its
// `.post_fx_passes = .{ .bloom, .vignette, .color_grade, .crt }` manifest.
// A handful of bright radial orbs bob in the dark so the bloom threshold
// catches their cores, the vignette frames the scene, color-grade lifts
// it, and the CRT pass lays down scanlines + a curve — post-fx you can see
// in a single screenshot.
//
// SCOPE NOTE (precise): gfx#305 has TWO halves. This demo exercises the
// POST-FX half only. The PER-ENTITY MATERIAL half (palette_swap / flash /
// dissolve / outline) is plumbed through core + gfx (`SpriteVisual.material`)
// and the pinned engine 2.12.2 DOES expose `game.setMaterial(entity, m)`
// (labelle-engine `src/game/visuals.zig`) — it was engine 2.6.0, this
// demo's original pin, that had no authoring surface. The demo still does
// not drive per-entity materials; that is the follow-up in README.md.
//
// VERSION PINS: the RUNTIME packages (core/engine/gfx/cli) + the backend
// pin the RELEASED set — this game proves the released runtime path (see
// tile-explorer's note). bgfx is pinned explicitly (the registry enum
// default predates the post-fx shaders this demo needs, which 0.13.1 first
// carried), and that pin is 0.20.0: labelle-core 1.32.0 appended
// `MaterialEffect.pixel_water` and every bgfx release before 0.20.0
// switches EXHAUSTIVELY over that enum with no arm for it. CI clones
// labelle-core at `main` as a sibling checkout and the assembler's
// monorepo auto-discovery builds that sibling INSTEAD of the
// `.core_version` pin below, so a pre-0.20.0 bgfx failed sema there.
//
// The core pin FOLLOWS the backend pin, not the other way round. The
// assembler unifies every package onto `.core_version`, and released bgfx
// 0.20.0 has a HARD core floor of 1.28.0: `src/gfx/types.zig` types a
// struct field as `core.BackendTextureId` (core#328 phase 3, bgfx >=
// 0.15.0), which is analyzed eagerly. So on a STANDALONE checkout — no
// sibling labelle-core, i.e. the documented `labelle build` path — bgfx
// 0.20.0 over the previous core 1.26.0 pin died inside the backend:
//   labelle-bgfx/src/gfx/types.zig:17:38: error: root source file struct
//   'root' has no member named 'BackendTextureId'
// #731 shipped that pairing claiming it "builds against the pinned
// 1.26.0"; CI never saw it because the sibling core at `main` is >= 1.32.0
// AND the bgfx games are generate-only there (labelle-assembler#732). The
// v1.32.0 names bgfx 0.20.0 takes from `backend_contract` (`PixelWaterDraw`,
// `PIXEL_WATER_*`) are NOT a compile floor: they are reached only through
// `@hasField(MaterialEffect, "pixel_water")`-gated paths or lazily-analyzed
// top-level aliases, so 0.20.0 does compile against core 1.28.0 (proven
// standalone with a `labelle init --backend=bgfx` scaffold).
// The pin is 1.32.0 anyway: the core labelle-bgfx 0.20.0 was released
// against (its own build.zig.zon), the one on which the pixel_water effect
// the backend ships is reachable at all, and the core the curated `labelle
// init` trio now carries — so this demo and a fresh scaffold prove ONE
// pairing (core 1.32.0 / engine 2.12.2 / gfx 1.30.1), at or above
// labelle-bgfx's own `examples/bgfx-android` pins (core 1.32.0 / engine
// 2.11.0 / gfx 1.30.0). It satisfies every trio floor in build.zig /
// `src/init_cmd.zig:checkTrioFloors` (engine >= 2.11.0 → core >= 1.27.0 +
// gfx >= 1.28.0; gfx >= 1.30.0 → core >= 1.28.0 + engine >= 2.12.1).
// Verified STANDALONE (scratch LABELLE_HOME, registry tarballs at these
// exact tags, no sibling checkouts): install → generate → full `zig build`,
// exit 0.
// The ASSEMBLER is `local:../../` (in-tree source, the examples
// convention). On the fully-RELEASED `labelle` path this game builds on
// assembler 0.94.0 — bgfx takes the generic desktop `unifyCoreDiamond`
// codegen, unaffected by the sokol-desktop byte-anchor gap #611 fixes.
.{
    .name = "material_demo",
    .title = "LaBelle — Post-FX Showcase",
    .width = 480,
    .height = 270,
    .target_fps = 60,
    .backend = .bgfx,
    .backend_package = .{ .name = "bgfx", .repo = "github.com/labelle-toolkit/labelle-bgfx", .version = "0.20.0" },
    .y_axis = .down,
    .ecs = .zig_ecs,
    .initial_prefab = "main",
    .states = .{"playing"},
    .resources = .{
        .{ .name = "glow", .json = "assets/glow.json", .texture = "assets/glow.png" },
    },
    .layers = .{
        .{ .name = "world", .order = 0, .space = .world },
    },
    // The initial post-fx stack, seeded at startup. Each entry is validated
    // against the bgfx manifest's advertised passes at generate time
    // (capabilities.warnUnsupportedPostFx) — declare a pass the backend
    // lacks and the assembler warns instead of silently dropping it.
    .post_fx = .{
        // Glow: pixels brighter than `threshold` bleed into their neighbors.
        .{ .bloom = .{ .threshold = 0.55, .intensity = 1.1, .radius = 1.0 } },
        // Cinematic edge darkening toward a cool tint.
        .{ .vignette = .{ .intensity = 0.55, .radius = 0.85, .softness = 0.45, .tint = .{ 0.02, 0.02, 0.06 } } },
        // Gentle overall grade lift.
        .{ .color_grade = .{ .strength = 0.35, .lut = 0 } },
        // Subtle CRT: slight curve + scanlines + shadow mask.
        .{ .crt = .{ .curvature = 0.08, .scanline = 0.35, .mask = 0.25, .aberration = 0.12 } },
    },
    .core_version = "1.32.0",
    .engine_version = "2.12.2",
    .gfx_version = "1.30.1",
    .labelle_version = "1.58.0",
    // In-tree assembler (examples convention). Fully-released path: 0.94.0.
    .assembler_version = "local:../../",
}
