{
    // Loading scene — no entities, no sprite assets. The controller in
    // scripts/loading/loading_controller.zig drives the atlas-decode
    // progress bar via screen-space gizmos, which need no textures.
    //
    // No deferred assets: this scene demonstrates the "eager preloaded,
    // swap-in instantly" side of the RFC pattern — scenes with no
    // deferred assets become active immediately, here at the first
    // frame, without blocking on any PNG decode. Under the unified
    // format (engine v2.0, RFC #560/#563) an empty asset list is simply
    // the absence of any manifest, so there is no `assets:` block.
    "name": "loading",
    "children": []
}
