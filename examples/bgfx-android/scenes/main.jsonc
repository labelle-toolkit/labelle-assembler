{
    // Main scene — a minimal bgfx-on-Android render demo. Both shapes sit
    // on the screen-space `hud` layer so the 800×600 design coords (from
    // project.labelle) map straight onto the surface via the backend's
    // design→surface aspect-fit. World-space layers route through the
    // camera and would push content off-screen on a fresh scene.
    //
    // The pairing is deliberate: the rectangle exercises the flat-triangle
    // quad path, and the circle proves the fit is aspect-correct — its
    // radius is scaled per-axis by the design→surface fit factor, so it
    // stays round (not an ellipse) when the 4:3 design canvas is
    // letterboxed into the device's surface.
    "name": "main",
    "entities": [
        {
            "name": "rect",
            "components": {
                "Position": { "x": 100, "y": 180 },
                "Shape": {
                    "shape": { "rectangle": { "width": 180, "height": 180 } },
                    "color": { "r": 230, "g": 30, "b": 200, "a": 255 },
                    "layer": "hud",
                    "z_index": 1
                }
            }
        },
        {
            "name": "circle",
            "components": {
                "Position": { "x": 600, "y": 270 },
                "Shape": {
                    "shape": { "circle": { "radius": 90 } },
                    "color": { "r": 20, "g": 170, "b": 160, "a": 255 },
                    "layer": "hud",
                    "z_index": 1
                }
            }
        }
    ]
}
