// Showcase game (#611, docs/showcase-plan.md row 7) — sprite atlas +
// animation on sokol. A robot jogs across a scrolling strip of ground,
// collecting spinning coins under drifting clouds.
//
// Two animation surfaces, on purpose (they are the engine's two tiers):
//   * `AnimationDef` — the comptime character rig. `animations/runner.zon`
//     compiles into a precomputed sprite-name table; the run script plays
//     the `run` clip by writing table entries into the Sprite
//     (`run/bot_0001.png` … `run/bot_0006.png`, the atlas naming
//     convention the def expects).
//   * `SpriteAnimation` — the declarative one-clip primitive for
//     everything else. The coins' 4-frame spin is attached as data and
//     advanced by the ENGINE (`setDriveSpriteAnimations(true)`), no
//     per-frame game code.
//
// VERSION PINS — read this, the assembler pin is deliberate:
//   * RUNTIME packages (core/engine/gfx/cli) + the backend pin the
//     RELEASED set — this game proves the released RUNTIME path.
//   * The ASSEMBLER is `local:../../` (the in-tree source), matching every
//     sibling example in this repo: examples/ validate the assembler *under
//     test*, and — for THIS game specifically — the released assembler
//     0.94.0 cannot build it at all. gfx#305's material seam gave the sokol
//     backend's gfx module a direct `labelle-core` import; 0.94.0's
//     sokol-desktop byte-anchor codegen never unified it onto the app core,
//     so two `MaterialEffect` instances fail sema (see README.md). #611
//     fixes that. On the fully-RELEASED `labelle` path this game therefore
//     needs assembler >= 0.95.0 (the release carrying #611's fix, unreleased
//     until this PR merges + tags); bgfx/raylib were never affected and
//     their showcase games build on the released 0.94.0.
// The `local:` assembler ALSO keeps the ecs adapter resolvable in CI: a
// numbered pin stages `ecs/zig-ecs` from ~/.labelle/packages/assembler/
// <ver>/, which is only populated by a released assembler — an unreleased
// 0.95.0 has no such cache, so `local:` is the honest, buildable pin today.
.{
    .name = "sprite_runner",
    .title = "LaBelle — Sprite Runner Showcase",
    .width = 480,
    .height = 270,
    .target_fps = 60,
    .backend = .sokol,
    .backend_package = .{ .name = "sokol", .repo = "github.com/labelle-toolkit/labelle-sokol", .version = "0.5.0" },
    .y_axis = .down,
    .ecs = .zig_ecs,
    .initial_prefab = "main",
    .states = .{"playing"},
    .resources = .{
        .{ .name = "runner", .json = "assets/runner.json", .texture = "assets/runner.png" },
    },
    .layers = .{
        .{ .name = "world", .order = 0, .space = .world },
    },
    .core_version = "1.26.0",
    .engine_version = "2.6.0",
    .gfx_version = "1.28.1",
    .labelle_version = "1.58.0",
    // In-tree assembler (see the ASSEMBLER PIN note above): the sokol fix
    // this game needs ships in #611 and is unreleased. On the released
    // `labelle` path this game requires assembler >= 0.95.0 (post-#611).
    .assembler_version = "local:../../",
}
