.{
    .name = .rlimgui_bridge,
    .version = "0.1.0",
    // Required by Zig 0.16 when this manifest is resolved as a build root
    // (the assembler links the bridge as a path dep). Without it the
    // raylib+imgui build fails with "missing top-level 'fingerprint' field".
    .fingerprint = 0x2bc4f54d09ba7dc3,
    .minimum_zig_version = "0.15.2",
    .dependencies = .{
        // rlImGui pinned to main (2026-04-13). Was on
        // refs/heads/main.tar.gz — same #146 class of fragility.
        .rlImGui = .{
            .url = "https://github.com/raylib-extras/rlImGui/archive/286e11acd6c785004c9550c7ed3762add2ae3d47.tar.gz",
            .hash = "N-V-__8AAKW_iQAqIz0VKzpwDjcutAHrY1MFFrQFYuTrihyz",
        },
        .cimgui = .{
            .url = "git+https://github.com/floooh/dcimgui.git#4557d7526fdd977f46ca10c2bbdd63532254f8d6",
            .hash = "cimgui-0.1.0-44ClkXnYlwBKnil7TfCWL9z1Zo_2YJCJREzrpdFiGvA1",
        },
        // Pinned to match backends/raylib/build.zig.zon and
        // plugins/nuklear/bridges/raylib/build.zig.zon so all three
        // halves of the raylib path resolve the same upstream version.
        // Bumped from the stale 5.6.0-dev pin (commit cd71c85) to 6.0.0
        // (commit f25c517) to match backends/raylib: raylib-zig 5.6.0-dev's
        // build.zig used `std.mem.trimLeft` / `std.process.getEnvVarOwned`,
        // both removed in Zig 0.16, so the raylib+imgui path failed to build
        // on the toolkit's pinned 0.16 toolchain.
        .@"raylib-zig" = .{
            .url = "git+https://github.com/raylib-zig/raylib-zig#f25c5173b4c40ef53c7ccf6d8d51ead0892f9f22",
            .hash = "raylib_zig-6.0.0-KE8REDJ4BQBu7lKwYNt6R4j5ywPeS37zqW6zrtjCcRwH",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
