.{
    .fingerprint = 0x312df839bf864b91,
    .name = .labelle_sokol,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .sokol = .{
            // MUST match the labelle-imgui top-level `.sokol` pin and
            // the labelle-imgui `bridges/sokol/build.zig.zon` pin
            // exactly — mismatched commits trigger duplicate-module
            // errors at build time across consumers that pull both
            // labelle-imgui and labelle-assembler (see labelle-assembler#207).
            // Pinned to the labelle-toolkit fork of sokol-zig, branch
            // `feat/with-sokol-imgui-no-app`, which adds the
            // `with_sokol_imgui_no_app` build option on top of upstream
            // floooh/sokol-zig @ 8b1a651. The option defines
            // `SOKOL_IMGUI_NO_SOKOL_APP` when compiling sokol_imgui.c
            // so labelle-imgui's headless preview mode can drive simgui
            // via `simgui_new_frame(width/height/dpi_scale/...)`. The
            // assembler doesn't pass that option itself — pinning the
            // fork is purely to align the package hash with imgui's
            // dependency tree. Default is false → backward compatible
            // with upstream. Bumping requires `zig fetch --save=sokol <url>`.
            .url = "https://github.com/labelle-toolkit/sokol-zig/archive/6b8609d022a095a757d66d8b00acd5c4cc80cdfc.tar.gz",
            .hash = "sokol-0.1.0-pb1HK_FiNwBdV4BfvYXfUbDC1lhXcBeBOyy5zLCERSAa",
        },
        // emsdk is needed at WASM build time so we can plumb the
        // sysroot include path through to `stb_image_impl.c`. The
        // assembler-generated `build.zig.zon` already declares an
        // `emsdk` dep at the same version for the link step
        // (`wasm_emsdk_sokol` template section); we mirror it here so
        // the gfx module's C compile can resolve `<stdlib.h>` and the
        // other emsdk system headers (labelle-cli#197).
        .emsdk = .{
            .url = "git+https://github.com/emscripten-core/emsdk#4.0.9",
            .hash = "N-V-__8AAJl1DwBezhYo_VE6f53mPVm00R-Fk28NPW7P14EQ",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
