.{
    .fingerprint = 0x312df839bf864b91,
    .name = .labelle_sokol,
    .version = "0.1.0",
    .minimum_zig_version = "0.15.2",
    .dependencies = .{
        .sokol = .{
            // Pinned to upstream floooh/sokol-zig. Historically this
            // pointed at the labelle-toolkit fork of sokol-zig (branch
            // `feat/expose-cached-metal-drawable`) which restored a
            // `sapp_metal_get_current_drawable` accessor for an early
            // Path B Metal/IOSurface readback experiment. We've since
            // switched to Path A — an offscreen IOSurface-backed render
            // target — which never reads the post-frame drawable, so
            // the fork patch is no longer needed. See floooh/sokol#1510
            // (closed) for the upstream rationale. Bumping requires
            // `zig fetch --save=sokol <url>`.
            .url = "https://github.com/floooh/sokol-zig/archive/8b1a651e6b8e76af3063a4094a5935432eb8afe2.tar.gz",
            .hash = "sokol-0.1.0-pb1HK1lhNwCdIF2-WujvJqi1YoK7Qvgm14Ywmup5C6_q",
        },
        // emsdk is needed at WASM build time so we can plumb the
        // sysroot include path through to `stb_image_impl.c`. The
        // assembler-generated `build.zig.zon` already declares an
        // `emsdk` dep at the same version for the link step
        // (`wasm_emsdk_sokol` template section); we mirror it here so
        // the gfx module's C compile can resolve `<stdlib.h>` and the
        // other emsdk system headers (labelle-cli#197).
        .emsdk = .{
            .url = "git+https://github.com/emscripten-core/emsdk#4.0.9",
            .hash = "N-V-__8AAJl1DwBezhYo_VE6f53mPVm00R-Fk28NPW7P14EQ",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
