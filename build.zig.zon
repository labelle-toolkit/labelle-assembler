.{
    .fingerprint = 0x71cf045810176ea4,
    .name = .labelle_assembler,
    .version = "0.62.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zspec = .{
            .url = "https://github.com/apotema/zspec/archive/v0.9.2.tar.gz",
            .hash = "zspec-0.9.1-jaKLbXgMBACFwbNjflhbMyP113leoYjboxn-1UOP-FGw",
        },
        // The pure-Zig `.flow.jsonc` parser + Zig-source codegen used by
        // `zig build generate` to emit script files — no imgui/zgui
        // editor stack. Formerly an in-tree sub-package of labelle-gui
        // consumed via `.path = "../labelle-gui/flow-codegen"`; that
        // relative path broke whenever this package was itself fetched
        // as a dependency (the sibling `../labelle-gui` isn't there).
        // Now its own URL-pinned repo so any consumer resolves it.
        //
        // Pinned to flow-codegen `main` (4073b58): RFC-FLOW-VOCABULARY
        // phase 6 — retires the legacy `event:` header; flows now use
        // pure node-form `Event/Emit` with name-routed dispatch. Phase
        // 3 (CustomNode + v1→v2 converter) landed in df31f1e; phases
        // 1+2 (events-as-nodes, variables, nullable variable ops,
        // multi-trigger flows) in 8948602 and a8be4c1. The assembler
        // test suite expects this vocabulary — older pins (e.g.
        // 64baa55) cause the flow_scanner tests to fail (8 failures).
        //
        // NOTE on labelle-assembler#176 (zig fetch EndOfStream):
        // that error is Zig's git smart-http transport reporting
        // GitHub's "no such object" response for an unknown 40-char
        // sha. If you see it on a pin bump, double-check the full sha
        // exists in the remote (`git ls-remote ... <sha>` or `git
        // -C ../flow-codegen rev-parse <sha>`). Truncated/typo'd
        // shas surface as EndOfStream, not a clear "not found".
        .flow_codegen = .{
            .url = "git+https://github.com/labelle-toolkit/flow-codegen.git?ref=v0.2.0#82e8c3d1899707124242c9bdd4ccf9376e4c7783",
            .hash = "flow_codegen-0.1.0-PFKUp-upCgBZvpfJeM-gBX5-cSE6bDsrG8cJJ06zdvCe",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
