.{
    .fingerprint = 0x71cf045810176ea4,
    .name = .labelle_assembler,
    .version = "0.19.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zspec = .{
            .url = "https://github.com/apotema/zspec/archive/v0.9.1.tar.gz",
            .hash = "zspec-0.9.1-jaKLbbX4AwBKANdetxzzWc3UTO0UY0lcJJzTagQHlt5K",
        },
        // In-tree sibling sub-package shipped from labelle-gui (#94).
        // The pure-Zig `.flow.zon` parser + Zig-source codegen lives
        // there so `zig build generate` can emit script files without
        // pulling in the editor's imgui/zgui stack. Path is relative to
        // this package and assumes the canonical sibling-clones toolkit
        // layout (`../labelle-gui/`).
        .flow_codegen = .{
            .path = "../labelle-gui/flow-codegen",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
