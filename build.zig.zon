.{
    .fingerprint = 0x71cf045810176ea4,
    .name = .labelle_assembler,
    .version = "0.31.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zspec = .{
            .url = "https://github.com/apotema/zspec/archive/v0.9.2.tar.gz",
            .hash = "zspec-0.9.1-jaKLbXgMBACFwbNjflhbMyP113leoYjboxn-1UOP-FGw",
        },
        // The pure-Zig `.flow.jsonc` parser + Zig-source codegen used by
        // `zig build generate` to emit script files — no imgui/zgui
        // editor stack. Formerly an in-tree sub-package of labelle-gui
        // consumed via `.path = "../labelle-gui/flow-codegen"`; that
        // relative path broke whenever this package was itself fetched
        // as a dependency (the sibling `../labelle-gui` isn't there).
        // Now its own URL-pinned repo so any consumer resolves it.
        // Pinned to flow-codegen `main` (64baa55): RFC-PLUGIN-EVENTS
        // phase 7 — adds the optional `priority: ?i32` field on
        // `OnEvent` for consumable-event listener ordering
        // (labelle-core#16). Phase 3 codegen (`FlowEventHandler`/
        // `game_ptr`, `Emit` node lowering, legacy → name converter)
        // landed in 1182a80; phases 1 / 2 in 602aebd (this repo) and
        // labelle-box2d 6c44691.
        .flow_codegen = .{
            .url = "git+https://github.com/labelle-toolkit/flow-codegen#64baa555bbf4a4d861113b7a3ce71aa0ef75ff05",
            .hash = "flow_codegen-0.1.0-PFKUp8q2AwDIb1AkFLQFpLYX1osK9gjNU87-WJxsSFF4",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
