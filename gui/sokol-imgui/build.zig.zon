.{
    .fingerprint = 0x160a1d344d104279,
    .name = .labelle_sokol_imgui,
    .version = "0.1.0",
    .minimum_zig_version = "0.15.2",
    .dependencies = .{
        .sokol = .{
            // MUST match `backends/sokol/build.zig.zon` and the
            // labelle-imgui sokol pin exactly — mismatched commits
            // trigger duplicate-module errors at build time across
            // consumers that pull both labelle-imgui and the assembler
            // (see labelle-assembler#207). Pinned to the labelle-toolkit
            // fork of sokol-zig (branch `feat/with-sokol-imgui-no-app`),
            // which adds the `with_sokol_imgui_no_app` build option on
            // top of upstream floooh/sokol-zig @ 8b1a651. See #146 for
            // the original pin rationale.
            .url = "https://github.com/labelle-toolkit/sokol-zig/archive/6b8609d022a095a757d66d8b00acd5c4cc80cdfc.tar.gz",
            .hash = "sokol-0.1.0-pb1HK_FiNwBdV4BfvYXfUbDC1lhXcBeBOyy5zLCERSAa",
        },
        .cimgui = .{
            .url = "git+https://github.com/floooh/dcimgui.git#4557d7526fdd977f46ca10c2bbdd63532254f8d6",
            .hash = "cimgui-0.1.0-44ClkXnYlwBKnil7TfCWL9z1Zo_2YJCJREzrpdFiGvA1",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
